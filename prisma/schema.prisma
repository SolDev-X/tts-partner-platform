generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  wechat    String
  message   String?
  service   String?
  spec      String?
  createdAt DateTime @default(now())
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING_CONFIRMATION
  WAITING_FOR_CUSTOMER
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDING
  REFUNDED
}

enum MaterialStatus {
  PENDING
  SUBMITTED
  APPROVED
  NEEDS_REVISION
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDING
  REFUNDED
}

model User {
  id            String  @id @default(cuid())
  name          String?
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  phoneNumber         String?   @unique
  phoneNumberVerified Boolean   @default(false)
  role                UserRole  @default(CUSTOMER)
  onboardingRequired  Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  sessions            Session[]
  accounts            Account[]
  orders              Order[]
}

model Order {
  id                    String          @id @default(cuid())
  orderNumber           String          @unique
  userId                String
  serviceId             String
  serviceLabel          String
  selection             Json
  status                OrderStatus     @default(PENDING_PAYMENT)
  customerNote          String?
  customerMessage       String?
  adminNote             String?
  amountInCents         Int?
  currency              String          @default("CNY")
  paymentStatus         PaymentStatus   @default(UNPAID)
  paymentChannel        String?
  transactionId         String?
  paidAt                DateTime?
  refundedAmountInCents Int             @default(0)
  refundedAt            DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  materials             OrderMaterial[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderMaterial {
  id            String         @id @default(cuid())
  orderId       String
  key           String
  label         String
  status        MaterialStatus @default(PENDING)
  fileName      String?
  storageKey    String?
  mimeType      String?
  size          Int?
  customerNote  String?
  adminFeedback String?
  submittedAt   DateTime?
  reviewedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, key])
  @@index([orderId, status])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id           String   @id @default(cuid())
  userId       String
  accountId    String
  providerId   String
  password     String?
  accessToken  String?
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
